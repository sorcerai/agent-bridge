# agent-bridge configuration. Copy to .env, fill in, `chmod 600 .env`.
# Load into a shell with:  set -a; . ./.env; set +a
# Never commit .env (it is in .gitignore).

# ---- Required (the poller exits 2 if either is missing) ---------------------
# Your OpenAI Secure MCP Tunnel id. Allowed characters: A-Z a-z 0-9 _ -
BRIDGE_TUNNEL_ID=tunnel_REPLACE_ME
# API key the tunnel control plane accepts. Sent only to https://api.openai.com
# as "Authorization: Bearer ...". Never logged, never passed to the MCP child.
OPENAI_API_KEY=sk-REPLACE_ME

# ---- Caller gate ------------------------------------------------------------
# Pinned x-openai-subject fingerprint: 16 lowercase hex chars, copied from the
# poller log (see README "Capture your caller's fingerprint").
# Leave EMPTY on first run: every private call is then rejected (fail closed)
# and logged with its fingerprint so you can capture your own.
# The subject-watch hook must see the same value.
BRIDGE_SUBJECT_FINGERPRINT=

# ---- State paths (optional) -------------------------------------------------
# State root: bridge.db, logs/, run/, secrets/, FROZEN, hooks/
#BRIDGE_STATE_DIR=$HOME/.local/state/agent-bridge
# SQLite queue store
#BRIDGE_DB=$HOME/.local/state/agent-bridge/bridge.db
# MCP child diagnostics log
#BRIDGE_MCP_LOG=$HOME/.local/state/agent-bridge/logs/bridge-mcp.log
# Freeze marker (mostly useful for tests)
#BRIDGE_FROZEN_FILE=$HOME/.local/state/agent-bridge/FROZEN
# Repo root; derived from each script's location when unset
#BRIDGE_HOME=/path/to/agent-bridge
# Interpreter for the MCP child (Python 3.12+)
#BRIDGE_PYTHON=/usr/bin/python3

# ---- Optional Slack ping on enqueue (host -> remote wake path) -------------
# Disabled unless set. Also requires a `slack` CLI on PATH that supports
# `call-tool --name slack_send_message`; otherwise the ping is skipped silently.
BRIDGE_SLACK_CHANNEL_ID=
# Set to 0 to suppress the ping for one run
#BRIDGE_SLACK_PING=1

# ---- Hooks (optional; see hooks/README.md) ----------------------------------
# Bash file defining silent/wake/log; unset = built-in JSON-line stubs
#BRIDGE_HOOK_RUNTIME=/path/to/your/hook-runtime.sh
# Hook cursors/offsets/dedupe/locks
#BRIDGE_HOOK_STATE_DIR=$HOME/.local/state/agent-bridge/hooks
# 1 = decide without persisting state, restarting, or freezing
#BRIDGE_HOOK_DRY_RUN=0
# Opaque routing hint added to built-in stub output as "target"
#BRIDGE_WAKE_TARGET=your-chat-or-channel-id
# Stale threshold (seconds) for bridge-inbox-watch.sh
#BRIDGE_INBOX_STALE_SECS=1800

# ---- Egress proxy (optional) ------------------------------------------------
# Passed to the MCP child with any user:password@ stripped.
#https_proxy=http://proxy.example.internal:3128
#no_proxy=localhost,127.0.0.1
